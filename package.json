{
  "name": "auction-bonanza",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "auth:keys:local": "node scripts/generate-local-auth-keys.mjs",
    "db:dump": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql dump",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema migrate && dbmate --migrations-dir db/migrations --schema-file db/schema.sql dump",
    "db:new": "dbmate --migrations-dir db/migrations new",
    "db:rollback": "dbmate --migrations-dir db/migrations --no-dump-schema rollback && dbmate --migrations-dir db/migrations --schema-file db/schema.sql dump",
    "db:status": "dbmate --migrations-dir db/migrations status",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm --recursive --if-present run test:unit",
    "test:unit:coverage": "pnpm --recursive --if-present run test:unit:coverage",
    "test:integration": "pnpm --recursive --if-present run test:integration",
    "test:integration:coverage": "pnpm --recursive --if-present run test:integration:coverage",
    "test:integration:local": "node scripts/with-local-test-env.mjs pnpm run test:integration",
    "test:e2e": "pnpm --filter @auction-bonanza/e2e-tests run test:e2e",
    "test:e2e:local": "node scripts/with-local-test-env.mjs pnpm run test:e2e",
    "test:sim:replay": "pnpm --filter @auction-bonanza/realtime-gateway run test:sim:replay",
    "web:dev": "pnpm --filter @auction-bonanza/web run dev",
    "loadgen:build": "go build -C tools/loadgen -o bin/loadgen ./cmd/loadgen",
    "loadgen:check": "node scripts/loadgen-check.mjs",
    "loadgen:test:integration": "go test -C tools/loadgen -race -count=1 -tags integration ./...",
    "loadgen:test:integration:local": "node scripts/with-local-test-env.mjs pnpm run loadgen:test:integration",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit:coverage && pnpm run build",
    "check:all": "pnpm run check && pnpm run test:integration && pnpm run test:e2e",
    "check:all:local": "CI=true node scripts/with-local-test-env.mjs pnpm run check:all"
  },
  "devDependencies": {
    "dbmate": "2.35.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@11.25.0"
}
