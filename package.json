{
  "name": "auction-bonanza",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@11.25.0"
}
