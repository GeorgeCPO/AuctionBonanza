# Development-only endpoints for the services in docker-compose.yml. The
# pnpm test:*:local scripts load this file; CI never does (it sets its own
# values in .github/workflows/ci.yml). Variables already set in your shell win
# over this file, so one value can still be overridden.
TEST_DATABASE_URL=postgresql://auction:auction_local@localhost:5432/auction_db
TEST_KAFKA_BROKERS=localhost:9092
TEST_KAFKA_FAULT_INJECTION_UPSTREAM=localhost:19093
TEST_VALKEY_NODES=localhost:7001,localhost:7002,localhost:7003
TEST_VALKEY_TOPOLOGY_NODES=localhost:7101,localhost:7102,localhost:7103
