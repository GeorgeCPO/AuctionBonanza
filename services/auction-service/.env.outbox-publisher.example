NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://auction:auction_local@localhost:5432/auction_db
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auction-outbox-publisher
AUCTION_EVENTS_TOPIC=auction.events
OUTBOX_PUBLISHER_CONCURRENCY=1
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_PUBLISH_TIMEOUT_MS=10000
OUTBOX_RETRY_BASE_DELAY_MS=500
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
OUTBOX_SHUTDOWN_TIMEOUT_MS=30000
