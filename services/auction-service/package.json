{
  "name": "@auction-bonanza/auction-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @auction-bonanza/http-routing build && pnpm --filter @auction-bonanza/access-auth build && pnpm --filter @auction-bonanza/contracts build && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:local": "node --env-file-if-exists=.env dist/index.js",
    "start:outbox-publisher": "node dist/outbox-publisher.main.js",
    "start:outbox-publisher:local": "node --env-file-if-exists=.env.outbox-publisher dist/outbox-publisher.main.js",
    "test": "pnpm --filter @auction-bonanza/http-routing build && pnpm --filter @auction-bonanza/access-auth build && pnpm --filter @auction-bonanza/contracts build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auction-bonanza/access-auth": "workspace:*",
    "@auction-bonanza/contracts": "workspace:*",
    "@auction-bonanza/http-routing": "workspace:*",
    "@confluentinc/kafka-javascript": "1.10.1",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.20.0"
  }
}
