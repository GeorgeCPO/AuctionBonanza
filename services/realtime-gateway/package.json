{
  "name": "@auction-bonanza/realtime-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @auction-bonanza/contracts build",
    "build": "pnpm run build:deps && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:relay": "node dist/relay.main.js",
    "start:relay:local": "node --env-file-if-exists=.env.relay dist/relay.main.js",
    "start:edge": "node dist/edge.main.js",
    "start:edge:local": "node --env-file-if-exists=.env.edge dist/edge.main.js",
    "test:unit": "pnpm run build:deps && vitest run -c vitest.unit.config.ts",
    "test:unit:coverage": "pnpm run build:deps && vitest run -c vitest.unit.config.ts --coverage",
    "test:integration": "pnpm run build:deps && vitest run -c vitest.integration.config.ts",
    "test:integration:coverage": "pnpm run build:deps && vitest run -c vitest.integration.config.ts --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auction-bonanza/contracts": "workspace:*",
    "@confluentinc/kafka-javascript": "1.10.1",
    "@sinclair/typebox": "0.34.52",
    "pino": "10.3.1",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.20.0"
  }
}
