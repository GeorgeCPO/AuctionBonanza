NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://auction:auction_local@localhost:5432/auction_db?sslmode=disable
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=settlement-worker
KAFKA_GROUP_ID=settlement-worker
AUCTION_EVENTS_TOPIC=auction.events
SETTLEMENT_DEAD_LETTER_TOPIC=auction.events.dlq
SETTLEMENT_PARTITION_CONCURRENCY=4
SETTLEMENT_DEAD_LETTER_TIMEOUT_MS=5000
SETTLEMENT_SESSION_TIMEOUT_MS=10000
SETTLEMENT_COMMIT_INTERVAL_MS=1000
SETTLEMENT_RETRY_BASE_DELAY_MS=200
SETTLEMENT_RETRY_MAX_DELAY_MS=10000
SETTLEMENT_SHUTDOWN_TIMEOUT_MS=15000
